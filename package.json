{
  "name": "mystrong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --only auth,firestore --project demo-mystrong",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mystrong \"node --test scripts/firestore-rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,functions"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "firebase": "12.19.0",
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.4",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.5",
    "firebase-admin": "^13.10.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
